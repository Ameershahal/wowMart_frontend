# Copy to `.env.production` before `npm run build`, or set these in Vercel/hosting.
# Default backend: Render

VITE_API_URL=https://wow-aovo.onrender.com/api

# Optional — only if file uploads use a different origin than the API host.
# VITE_API_ORIGIN=https://wow-aovo.onrender.com

# --- AWS / custom domain (previous setup) — use only if you point the app there again ---
# VITE_API_URL=https://api.wowmartindia.in/api
# VITE_API_ORIGIN=https://api.wowmartindia.in
